# Docker Compose local/intranet settings. Copy to .env and replace every secret.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 生产环境至少32字符；首次初始化完成后可清空并重启服务以关闭初始化入口。
BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token-at-least-32-chars

# Local HTTP development defaults. For an HTTPS intranet deployment, set
# APP_ENV=production, COOKIE_SECURE=true, ALLOW_DEMO_STANDARDS=false,
# ALLOW_OPEN_BOOTSTRAP=false, DOCS_ENABLED=false，并配置实际内网HTTPS域名。
APP_ENV=development
COOKIE_SECURE=false
ALLOW_DEMO_STANDARDS=true
ALLOW_OPEN_BOOTSTRAP=true
TRUSTED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://localhost:8000
DOCS_ENABLED=true

# Optional: share this original-document archive path between collector and web.
# STATISTICAL_ARCHIVE_DIR=C:/path/to/statistical-source-archive
